      "SignalResult": {
        "additionalProperties": false,
        "properties": {
          "abstained": {
            "description": "True when the call fell below the frozen confidence threshold.",
            "title": "Abstained",
            "type": "boolean"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "directional_tau": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "When set, a neutral lead still yields the likelier directional class once that class reaches this probability.",
            "title": "Directional Tau"
          },
          "policy": {
            "enum": [
              "probability",
              "label-logprob",
              "ordinal"
            ],
            "title": "Policy",
            "type": "string"
          },
          "probabilities": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "propertyNames": {
                  "enum": [
                    "bullish",
                    "bearish",
                    "neutral"
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Probabilities"
          },
          "score": {
            "anyOf": [
              {
                "maximum": 2.0,
                "minimum": -2.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "sentiment": {
            "enum": [
              "bullish",
              "bearish",
              "neutral"
            ],
            "title": "Sentiment",
            "type": "string"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Frozen cutoff this call was held to: the minimum winning-class probability (probability, label-logprob) or the minimum |score| (ordinal).",
            "title": "Threshold"
          }
        },
        "required": [
          "sentiment",
          "abstained",
          "policy"
        ],
        "title": "SignalResult",
        "type": "object"
      },
