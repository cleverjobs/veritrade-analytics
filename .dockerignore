# Allowlist: the image needs the lockfiles, the backend package and the frontend sources.
*
!.python-version
!pyproject.toml
!uv.lock
!backend/pyproject.toml
!backend/src/
!evals/pyproject.toml
!evals/results/benchmarks.json
!frontend/
frontend/node_modules
frontend/.next
frontend/out
frontend/e2e
frontend/tests
frontend/playwright.config.ts
frontend/vitest.config.mts
frontend/*.md
frontend/test-results
frontend/playwright-report
frontend/blob-report
frontend/src/data/benchmarks.json
frontend/next-env.d.ts
frontend/*.tsbuildinfo
**/__pycache__
**/.DS_Store
