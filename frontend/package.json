{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "benchmarks:copy": "node scripts/copy-benchmarks.mjs",
    "dev": "pnpm benchmarks:copy && next dev",
    "build": "pnpm benchmarks:copy && next build",
    "lint": "eslint",
    "typecheck": "pnpm benchmarks:copy && next typegen && tsc --noEmit",
    "test": "pnpm benchmarks:copy && vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/lib/api-schema.d.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24"
  }
}
